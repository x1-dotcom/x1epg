{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x1panel.space/schemas/x1-epg-source-v1.json",
  "title": "X1 EPG Source Manifest",
  "type": "object",
  "required": ["schemaVersion", "sourceGroup", "country", "timezone", "languages", "sources", "channels"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceGroup": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "type", "url", "ingestEnabled", "publishAllowed", "rightsStatus"],
        "properties": {
          "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"enum": ["xmltv", "xmltv-gzip"]},
          "url": {"type": "string", "pattern": "^https://"},
          "channelListUrl": {"type": ["string", "null"]},
          "priority": {"type": "integer", "minimum": 1},
          "ingestEnabled": {"type": "boolean"},
          "publishAllowed": {"type": "boolean"},
          "rightsStatus": {"enum": ["verified-redistributable", "public-feed-no-license-found", "permission-required", "unknown"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonicalId", "name", "aliases", "piconId", "tvgIds"],
        "properties": {
          "canonicalId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "piconId": {"type": ["string", "null"]},
          "tvgIds": {"type": "array", "items": {"type": "string"}},
          "sourceChannelId": {"type": "string", "minLength": 1},
          "sourceMappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceId", "channelId", "priority", "enabled"],
              "properties": {
                "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "channelId": {"type": "string", "minLength": 1},
                "priority": {"type": "integer", "minimum": 1},
                "enabled": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          }
        },
        "oneOf": [
          {"required": ["sourceChannelId"], "not": {"required": ["sourceMappings"]}},
          {"required": ["sourceMappings"], "not": {"required": ["sourceChannelId"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
