{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x1panel.space/schemas/x1-epg-catalog-v1.json",
  "title": "X1 EPG Catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "channels"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string"},
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonicalId", "name", "country", "timezone", "languages", "aliases", "sources", "status"],
        "properties": {
          "canonicalId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "timezone": {"type": "string", "minLength": 1},
          "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "piconId": {"type": ["string", "null"]},
          "tvgIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceId", "channelId", "priority", "enabled"],
              "properties": {
                "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "channelId": {"type": "string", "minLength": 1},
                "priority": {"type": "integer", "minimum": 1},
                "enabled": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "status": {"enum": ["active", "testing", "disabled", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
